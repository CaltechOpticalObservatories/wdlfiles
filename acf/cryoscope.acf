[CONFIG]
MOD10\DIO_DIR12=1
MOD10\DIO_DIR34=1
MOD10\DIO_POWER=1
MOD10\DIO_SOURCE1=3
MOD10\DIO_SOURCE2=3
MOD10\DIO_SOURCE3=3
MOD10\VCPU_INREG0=0
MOD10\VCPU_INREG1=0
MOD10\VCPU_INREG10=0
MOD10\VCPU_INREG11=0
MOD10\VCPU_INREG12=0
MOD10\VCPU_INREG13=0
MOD10\VCPU_INREG14=0
MOD10\VCPU_INREG15=0
MOD10\VCPU_INREG2=0
MOD10\VCPU_INREG3=0
MOD10\VCPU_INREG4=0
MOD10\VCPU_INREG5=0
MOD10\VCPU_INREG6=0
MOD10\VCPU_INREG7=0
MOD10\VCPU_INREG8=0
MOD10\VCPU_INREG9=0
MOD10\VCPU_LINE0="ALIAS r0 TriggerHw                ; reads hardware trigger"
MOD10\VCPU_LINE1="ALIAS r1 TriggerSw                ; reads software trigger"
MOD10\VCPU_LINE10=";"
MOD10\VCPU_LINE11="DIN_PORT=0x0000                   ; digital input port register"
MOD10\VCPU_LINE12="SOFT_TRIG=0x0010                  ; software trigger VCPU_INREG0"
MOD10\VCPU_LINE13="DATA_WORD=0x0011                  ; VCPU_INREG1 carries the word to write serially"
MOD10\VCPU_LINE14=
MOD10\VCPU_LINE15="; bitmasks"
MOD10\VCPU_LINE16=";"
MOD10\VCPU_LINE17="DATACLK_HI=1"
MOD10\VCPU_LINE18="DATACLK_LO=0"
MOD10\VCPU_LINE19="CSB_HI=2"
MOD10\VCPU_LINE2="ALIAS r2 Once                     ; allows one-shot software trigger"
MOD10\VCPU_LINE20="CSB_LO=0"
MOD10\VCPU_LINE21="DATAIN_HI=4"
MOD10\VCPU_LINE22="DATAIN_LO=0"
MOD10\VCPU_LINE23="HW_TRIG=0x10                      ; hardware trigger bit = DIO5"
MOD10\VCPU_LINE24=
MOD10\VCPU_LINE25="; Initialize Output Ports"
MOD10\VCPU_LINE26=";"
MOD10\VCPU_LINE27="LOAD ClockPort, 0x0101            ; ClockPort = DIO1"
MOD10\VCPU_LINE28="LOAD DataPort, 0x0104             ; DataPort = DIO3"
MOD10\VCPU_LINE29="LOAD SPI, 0x0107                  ; CLK=DIO1, CSB=DIO2, DATA=DIO3"
MOD10\VCPU_LINE3="ALIAS r3 Counter                  ; general purpose counter"
MOD10\VCPU_LINE30=
MOD10\VCPU_LINE31="LOAD Once, 0                      ; clear the Once flag"
MOD10\VCPU_LINE32="INPUT TriggerSw, SOFT_TRIG        ; read the software trigger once at program start only"
MOD10\VCPU_LINE33="TEST TriggerSw, 1"
MOD10\VCPU_LINE34="IF Z GOTO Init                    ; if clear then leave the Once flag clear"
MOD10\VCPU_LINE35="LOAD Once, HW_TRIG                ; otherwise set the Once flag same as a hardware trigger"
MOD10\VCPU_LINE36=
MOD10\VCPU_LINE37="; Initialize all ports and registers"
MOD10\VCPU_LINE38=";"
MOD10\VCPU_LINE39=Init:
MOD10\VCPU_LINE4="ALIAS r4 Data                     ; this register caries the data"
MOD10\VCPU_LINE40="OUTPUT SPI, 0x06                  ; DATAIN=HI, CSB=HI, CLK=LO (110)"
MOD10\VCPU_LINE41=
MOD10\VCPU_LINE42="; WaitForTrigger"
MOD10\VCPU_LINE43="; Loop here until either a hardware or software trigger is received"
MOD10\VCPU_LINE44=";"
MOD10\VCPU_LINE45=WaitForTriggerLO:
MOD10\VCPU_LINE46=";LOAD Counter, 1                  ; initialize Counter for LO state"
MOD10\VCPU_LINE47=
MOD10\VCPU_LINE48=TestTriggerLO:
MOD10\VCPU_LINE49="INPUT TriggerHw, DIN_PORT         ; read the hardware trigger"
MOD10\VCPU_LINE5="ALIAS r5 ClockPort                ; holds the address for the DATACLK port"
MOD10\VCPU_LINE50="TEST TriggerHw, HW_TRIG           ; Z = NOT(TriggerHw & HW_TRIG)"
MOD10\VCPU_LINE51="IF NZ GOTO WaitForTriggerLO       ; loop waiting until Trigger==0"
MOD10\VCPU_LINE52=";SUB Counter, 1                   ; decrement LO counter"
MOD10\VCPU_LINE53=";IF NZ GOTO TestTriggerLO         ; keep checking Trigger until LO for \"Counter\" cycles"
MOD10\VCPU_LINE54=
MOD10\VCPU_LINE55=WaitForTriggerHI:
MOD10\VCPU_LINE56=";LOAD Counter, 1                  ; initialize Counter for HI state"
MOD10\VCPU_LINE57=
MOD10\VCPU_LINE58=TestTriggerHI:
MOD10\VCPU_LINE59="INPUT TriggerHw, DIN_PORT         ; read the hardware trigger"
MOD10\VCPU_LINE6="ALIAS r7 DataPort                 ; holds the address for the DATAIN port"
MOD10\VCPU_LINE60="OR TriggerHw, Once                ; OR with Once register: TriggerHw=TriggerHw|Once"
MOD10\VCPU_LINE61="TEST TriggerHw, HW_TRIG           ; Z = NOT(TriggerHw & HW_TRIG)"
MOD10\VCPU_LINE62="IF Z GOTO WaitForTriggerHI        ; loop waiting until Trigger==1"
MOD10\VCPU_LINE63=";SUB Counter, 1                   ; increment HI counter"
MOD10\VCPU_LINE64=";IF NZ GOTO TestTriggerHI         ; keep checking Trigger until HI for \"Counter\" cycles"
MOD10\VCPU_LINE65=
MOD10\VCPU_LINE66="LOAD Counter, 16                  ; initialize Counter to 16 bit word length"
MOD10\VCPU_LINE67=
MOD10\VCPU_LINE68="; SendSerial"
MOD10\VCPU_LINE69="; jump here when a trigger is received to send the serial data word"
MOD10\VCPU_LINE7="ALIAS r9 SPI                      ; address for CLK/CS/DATA"
MOD10\VCPU_LINE70=";"
MOD10\VCPU_LINE71=SendSerial:
MOD10\VCPU_LINE72="INPUT Data, DATA_WORD             ; copy the requested word from the VCPU_INREG"
MOD10\VCPU_LINE73="OUTPUT SPI, 0x04                  ; enable CSB: DATAIN=HI, CSB=LO, CLK=LO (100)"
MOD10\VCPU_LINE74=
MOD10\VCPU_LINE75="SendSerialLoop:                   ; loop over this for each bit in the data word"
MOD10\VCPU_LINE76="OUTPUT SPI, 0x04                  ; each bit starts with DATA=HI and CLK=LO"
MOD10\VCPU_LINE77="SLA Data                          ; shift the MSB of Data into Carry"
MOD10\VCPU_LINE78="IF NC OUTPUT DataPort, DATAIN_LO  ; if C is clear then bring DATAIN LO"
MOD10\VCPU_LINE79="OUTPUT ClockPort, DATACLK_HI      ; then bring the clock HI"
MOD10\VCPU_LINE8=
MOD10\VCPU_LINE80="SUB Counter, 1                    ; decrement bit counter"
MOD10\VCPU_LINE81="IF NZ GOTO SendSerialLoop         ; keep looping over all bits in the data word"
MOD10\VCPU_LINE82="LOAD Once, 0                      ; clear the Once register to stop software triggers"
MOD10\VCPU_LINE83=GOTO Init
MOD10\VCPU_LINE84=
MOD10\VCPU_LINE9="; Define Constants"
MOD10\VCPU_LINES=85
BIGBUF=0
FRAMEMODE=1
LINECOUNT=2048
PIXELCOUNT=64
RAWENABLE=0
RAWENDLINE=10
RAWSAMPLES=25600
RAWSEL=0
RAWSTARTLINE=0
RAWSTARTPIXEL=0
SAMPLEMODE=0
SHP1=256
SHP2=692
SHD1=700
SHD2=700
TAPLINE0="AM26L,1,0"
TAPLINE1="AM45R,1,0"
TAPLINE2="AM28L,1,0"
TAPLINE3="AM49R,1,0"
TAPLINE4="AM43L,1,0"
TAPLINE5="AM47R,1,0"
TAPLINE6="AM30L,1,0"
TAPLINE7="AM33R,1,0"
TAPLINE8="AM32L,1,0"
TAPLINE9="AM48R,1,0"
TAPLINE10="AM23L,1,0"
TAPLINE11="AM40R,1,0"
TAPLINE12="AM35L,1,0"
TAPLINE13="AM27R,1,0"
TAPLINE14="AM44L,1,0"
TAPLINE15="AM22R,1,0"
TAPLINE16="AM50L,1,0"
TAPLINE17="AM31R,1,0"
TAPLINE18="AM53L,1,0"
TAPLINE19="AM25R,1,0"
TAPLINE20="AM41L,1,0"
TAPLINE21="AM34R,1,0"
TAPLINE22="AM39L,1,0"
TAPLINE23="AM21R,1,0"
TAPLINE24="AM46L,1,0"
TAPLINE25="AM54R,1,0"
TAPLINE26="AM36L,1,0"
TAPLINE27="AM51R,1,0"
TAPLINE28="AM52L,1,0"
TAPLINE29="AM29R,1,0"
TAPLINE30="AM42L,1,0"
TAPLINE31="AM24R,1,0"
TAPLINE32="AM37L,1,0"
TAPLINES=33
TRIGOUTFORCE=0
TRIGOUTINVERT=0
TRIGOUTLEVEL=0
TRIGOUTPOWER=1
PARAMETER0="Start=0"
PARAMETER1="Expose=0"
PARAMETER2="ExposeWindow=0"
PARAMETER3="exptime=0"
PARAMETER4="longexposure=0"
PARAMETER5="Abort=0"
PARAMETER6="mode_UTR_RR=1"
PARAMETER7="mode_UTR_GR=0"
PARAMETER8="mode_EnhancedRollingReset=0"
PARAMETER9="mode_VideoRX=0"
PARAMETER10="mode_VideoRXR=0"
PARAMETER11="mode_HighBrightnessXR=0"
PARAMETER12="mode_HighBrightnessXRXR=0"
PARAMETER13="mode_PermanentReset=0"
PARAMETER14="mode_Guiding=0"
PARAMETER15="mode_InterleavedGuiding=0"
PARAMETER16="exp_PulseWhileGlobReset=0"
PARAMETER17="H2RG_rows=2048"
PARAMETER18="H2RG_rows_skip=0"
PARAMETER19="H2RG_columns=64"
PARAMETER20="H2RG_win_rows=10"
PARAMETER21="H2RG_win_columns=10"
PARAMETER22="HighBrightnessRowResetInterval=0"
PARAMETER23="H2RGMainReset=0"
PARAMETER24="EnhancedRR_Delta=100"
PARAMETER25="Hold4Programming=0"
PARAMETER26="WindowPixelNb=100"
PARAMETER27="prv_flag_reset=0"
PARAMETER28="prv_ghostframe=0"
PARAMETER29="prv_firstrow=0"
PARAMETER30="prv_HBRRI_counter=0"
PARAMETER31="prv_ERR_DeltaCounter=0"
PARAMETERS=32
LINE0=Init:
LINE1="STATE000; CALL InitClocks"
LINE2="STATE000; CALL wCLKEn"
LINE3="STATE000; CALL ResetRegistersDefault"
LINE4="STATE000; if Start GOTO WaitForExpose"
LINE5="STATE000; GOTO Init"
LINE6=ResetRegHxRG:
LINE7="STATE000; CALL ResetRegistersDefault"
LINE8="STATE000; H2RGMainReset--"
LINE9="STATE000; RETURN ResetRegHxRG"
LINE10=WaitForExpose:
LINE11="STATE000; if Expose CALL SelectMode"
LINE12="STATE000; if H2RGMainReset CALL ResetRegHxRG"
LINE13="STATE000; GOTO WaitForExpose"
LINE14=SelectMode:
LINE15="STATE000; if mode_UTR_RR CALL UTR_RR_Sequence"
LINE16="STATE000; if mode_UTR_GR CALL UTR_GR_Sequence"
LINE17="STATE000; if mode_VideoRX CALL VideoRX_Sequence"
LINE18="STATE000; if mode_VideoRXR CALL VideoRXR_Sequence"
LINE19="STATE000; if mode_PermanentReset CALL PGR_Sequence"
LINE20="STATE000; if mode_EnhancedRollingReset CALL EnhancedRR_Sequence"
LINE21="STATE000; if mode_HighBrightnessXR CALL HighBrightnessXR_Sequence"
LINE22="STATE000; if mode_HighBrightnessXRXR CALL HighBrightnessXRXR_Sequence"
LINE23="STATE000; if exp_PulseWhileGlobReset CALL Persistence_PulseGlobalReset"
LINE24="STATE000; if mode_Guiding CALL Guiding_Sequence"
LINE25="STATE000; GOTO WaitForExpose"
LINE26=UTR_RR_Sequence:
LINE27="STATE000; prv_flag_reset++"
LINE28="STATE000; CALL UTR_RR_GrabFrame(Expose)"
LINE29="STATE000; GOTO WaitForExpose"
LINE30=UTR_RR_GrabFrame:
LINE31="STATE000; Expose--"
LINE32="STATE000; Expose--"
LINE33="STATE000; if !prv_flag_reset CALL ExposureTimer"
LINE34="STATE000; CALL wFrame"
LINE35="STATE000; CALL StartFrame"
LINE36="STATE000; if prv_flag_reset CALL ResetHI"
LINE37="STATE000; if !prv_flag_reset CALL ResetDummy"
LINE38="STATE000; CALL StartRow"
LINE39="STATE000; CALL RR_SkipRow(H2RG_rows_skip)"
LINE40="STATE000; CALL RR_ReadRow(H2RG_rows)"
LINE41="STATE000; CALL PulseVCLK"
LINE42="STATE000; if prv_flag_reset CALL ResetLO"
LINE43="STATE000; if !prv_flag_reset CALL ResetDummy"
LINE44="STATE000; prv_flag_reset--"
LINE45="STATE000; RETURN UTR_RR_GrabFrame"
LINE46=RR_ReadRow:
LINE47="STATE000; CALL wLine"
LINE48="STATE000; CALL StartRow"
LINE49="STATE000; CALL wReadEN"
LINE50="STATE000; CALL ReadPixel_Blank(2)"
LINE51="STATE000; CALL ReadPixel(H2RG_columns)"
LINE52="STATE000; CALL wbHclk"
LINE53="STATE000; CALL wbReadEN"
LINE54="STATE000; RETURN RR_ReadRow"
LINE55=RR_SkipRow:
LINE56="STATE000; CALL StartRow"
LINE57="STATE000; if prv_flag_reset CALL ResetPulse"
LINE58="STATE000; RETURN RR_SkipRow"
LINE59=UTR_GR_Sequence:
LINE60="STATE000; prv_flag_reset++"
LINE61="STATE000; CALL ResetPulse"
LINE62="STATE000; CALL UTR_GR_GrabFrame(Expose)"
LINE63="STATE000; GOTO WaitForExpose"
LINE64=PGR_Sequence:
LINE65="STATE000; CALL wResetEN"
LINE66="STATE000; CALL UTR_GR_GrabFrame(Expose)"
LINE67="STATE000; CALL wbResetEN"
LINE68="STATE000; GOTO WaitForExpose"
LINE69=UTR_GR_GrabFrame:
LINE70="STATE000; Expose--"
LINE71="STATE000; CALL wFrame"
LINE72="STATE000; CALL StartFrame"
LINE73="STATE000; CALL PulseVCLK"
LINE74="STATE000; CALL GR_ReadRow(H2RG_rows)"
LINE75="STATE000; CALL PulseVCLK"
LINE76="STATE000; prv_flag_reset--"
LINE77="STATE000; RETURN UTR_GR_GrabFrame"
LINE78=GR_ReadRow:
LINE79="STATE000; CALL wLine"
LINE80="STATE000; CALL StartRow"
LINE81="STATE000; CALL wReadEN"
LINE82="STATE000; CALL ReadPixel_Blank(2)"
LINE83="STATE000; CALL ReadPixel(64)"
LINE84="STATE000; CALL wbHclk"
LINE85="STATE000; CALL wbReadEN"
LINE86="STATE000; RETURN GR_ReadRow"
LINE87=VideoRX_Sequence:
LINE88="STATE000; if Expose CALL VideoRX_GrabFrame"
LINE89="STATE000; if Abort CALL AbortSeq"
LINE90="STATE000; if !Expose GOTO WaitForExpose"
LINE91="STATE000; GOTO VideoRX_Sequence"
LINE92=VideoRX_GrabFrame:
LINE93="STATE000; if !prv_ghostframe CALL wFrame"
LINE94="STATE000; CALL StartFrame"
LINE95="STATE000; CALL StartRow"
LINE96="STATE000; CALL RR_SkipRow(H2RG_rows_skip)"
LINE97="STATE000; CALL RX_ReadRow(H2RG_rows)"
LINE98="STATE000; CALL PulseVCLK"
LINE99="STATE000; CALL ExposureTimer"
LINE100="STATE000; if !prv_ghostframe CALL DecrExposeCpt"
LINE101="STATE000; RETURN VideoRX_GrabFrame"
LINE102=RX_ReadRow:
LINE103="STATE000; CALL wLine"
LINE104="STATE000; CALL StartRow"
LINE105="STATE000; CALL wReadEN"
LINE106="STATE000; CALL ReadPixel_Blank(2)"
LINE107="STATE000; CALL ReadPixel(H2RG_columns)"
LINE108="STATE000; CALL ResetPulse"
LINE109="STATE000; CALL wbHclk"
LINE110="STATE000; CALL wbReadEN"
LINE111="STATE000; RETURN RX_ReadRow"
LINE112=HighBrightnessXR_Sequence:
LINE113="STATE000; if Expose CALL HighBrightnessXR_GrabFrame"
LINE114="STATE000; if Abort CALL AbortSeq"
LINE115="STATE000; if !Expose GOTO WaitForExpose"
LINE116="STATE000; GOTO HighBrightnessXR_Sequence"
LINE117=HighBrightnessXR_GrabFrame:
LINE118="STATE000; if !prv_ghostframe CALL wFrame"
LINE119="STATE000; CALL StartFrame"
LINE120="STATE000; CALL StartRow"
LINE121="STATE000; CALL RR_SkipRow(H2RG_rows_skip)"
LINE122="STATE000; CALL HighBrightnessXR_ReadRow(H2RG_rows)"
LINE123="STATE000; CALL PulseVCLK"
LINE124="STATE000; if !prv_ghostframe CALL DecrExposeCpt"
LINE125="STATE000; RETURN HighBrightnessXR_GrabFrame"
LINE126=HighBrightnessXR_ReadRow:
LINE127="STATE000; CALL wLine"
LINE128="STATE000; CALL StartRow"
LINE129="STATE000; CALL wReadEN"
LINE130="STATE000; CALL ReadPixel_Blank(2)"
LINE131="STATE000; if !prv_HBRRI_counter CALL ResetPulse"
LINE132="STATE000; if !prv_HBRRI_counter CALL ExposureTimer_us"
LINE133="STATE000; if !prv_HBRRI_counter CALL Inc_HBRRI_Counter(HighBrightnessRowResetInterval)"
LINE134="STATE000; if prv_HBRRI_counter CALL Dec_HBRRI_Counter(1)"
LINE135="STATE000; CALL ReadPixel(H2RG_columns)"
LINE136="STATE000; CALL wbHclk"
LINE137="STATE000; CALL wbReadEN"
LINE138="STATE000; RETURN HighBrightnessXR_ReadRow"
LINE139=VideoRXR_Sequence:
LINE140="STATE000; if Expose CALL VideoRXR_GrabFrame"
LINE141="STATE000; if Abort GOTO AbortSeq"
LINE142="STATE000; if !Expose GOTO WaitForExpose"
LINE143="STATE000; GOTO VideoRXR_Sequence"
LINE144=VideoRXR_GrabFrame:
LINE145="STATE000; if !prv_ghostframe CALL wFrame"
LINE146="STATE000; CALL StartFrame"
LINE147="STATE000; CALL StartRow"
LINE148="STATE000; prv_firstrow++"
LINE149="STATE000; if H2RG_rows_skip CALL RR_SkipRow(H2RG_rows_skip)"
LINE150="STATE000; CALL RXR_ReadRow(H2RG_rows)"
LINE151="STATE000; CALL PulseVCLK"
LINE152="STATE000; CALL ExposureTimer"
LINE153="STATE000; if !prv_ghostframe CALL DecrExposeCpt"
LINE154="STATE000; RETURN VideoRXR_GrabFrame"
LINE155=RXR_ReadRow:
LINE156="STATE000; CALL wLine"
LINE157="STATE000; CALL StartRow"
LINE158="STATE000; prv_firstrow--"
LINE159="STATE000; CALL wReadEN"
LINE160="STATE000; CALL ReadPixel_Blank(2)"
LINE161="STATE000; CALL ReadPixel(H2RG_columns)"
LINE162="STATE000; CALL ResetPulse"
LINE163="STATE000; CALL LSyncBPulse"
LINE164="STATE000; CALL ReadPixel_Blank(1)"
LINE165="STATE000; CALL ReadPixel(H2RG_columns)"
LINE166="STATE000; CALL wbHclk"
LINE167="STATE000; CALL wbReadEN"
LINE168="STATE000; RETURN RXR_ReadRow"
LINE169=HighBrightnessXRXR_Sequence:
LINE170="STATE000; if Expose CALL HighBrightnessXRXR_GrabFrame"
LINE171="STATE000; if Abort CALL AbortSeq"
LINE172="STATE000; if !Expose GOTO WaitForExpose"
LINE173="STATE000; GOTO HighBrightnessXRXR_Sequence"
LINE174=HighBrightnessXRXR_GrabFrame:
LINE175="STATE000; if !prv_ghostframe CALL wFrame"
LINE176="STATE000; CALL StartFrame"
LINE177="STATE000; CALL StartRow"
LINE178="STATE000; CALL RR_SkipRow(H2RG_rows_skip)"
LINE179="STATE000; CALL HighBrightnessXRXR_ReadRow(H2RG_rows)"
LINE180="STATE000; CALL PulseVCLK"
LINE181="STATE000; if !prv_ghostframe CALL DecrExposeCpt"
LINE182="STATE000; RETURN HighBrightnessXRXR_GrabFrame"
LINE183=HighBrightnessXRXR_ReadRow:
LINE184="STATE000; CALL wLine"
LINE185="STATE000; CALL StartRow"
LINE186="STATE000; CALL wReadEN"
LINE187="STATE000; if !prv_HBRRI_counter CALL ResetPulse"
LINE188="STATE000; if !prv_HBRRI_counter CALL ExposureTimer_us"
LINE189="STATE000; if !prv_HBRRI_counter CALL Inc_HBRRI_Counter(HighBrightnessRowResetInterval)"
LINE190="STATE000; if prv_HBRRI_counter CALL Dec_HBRRI_Counter(1)"
LINE191="STATE000; CALL ReadPixel_Blank(2)"
LINE192="STATE000; CALL ReadPixel(H2RG_columns)"
LINE193="STATE000; CALL wResetEN"
LINE194="STATE000; CALL LSyncBPulse"
LINE195="STATE000; CALL ReadPixel_Blank(1)"
LINE196="STATE000; CALL ReadPixel(H2RG_columns)"
LINE197="STATE000; CALL wbResetEN"
LINE198="STATE000; CALL wbHclk"
LINE199="STATE000; CALL wbReadEN"
LINE200="STATE000; RETURN HighBrightnessXRXR_ReadRow"
LINE201=Persistence_PulseGlobalReset:
LINE202="STATE000; CALL wResetEN"
LINE203="STATE000; CALL UTR_GR_GrabFrame(10)"
LINE204="STATE000; CALL wbResetEN"
LINE205="STATE000; CALL UTR_GR_GrabFrame(100)"
LINE206="STATE000; RETURN Persistence_PulseGlobalReset"
LINE207=EnhancedRR_Sequence:
LINE208="STATE000; CALL ConfigureEnhancedMode"
LINE209="STATE000; CALL EnhancedRR_GrabFrame(Expose)"
LINE210="STATE000; GOTO WaitForExpose"
LINE211=EnhancedRR_GrabFrame:
LINE212="STATE000; Expose--"
LINE213="STATE000; CALL INC_ERR_DeltaCounter(H2RG_rows)"
LINE214="STATE000; CALL DEC_ERR_DeltaCounter(EnhancedRR_Delta)"
LINE215="STATE000; CALL wbFSyncB"
LINE216="STATE000; CALL HDCRR_ReadRow(EnhancedRR_Delta)"
LINE217="STATE000; CALL wFSyncB"
LINE218="STATE000; CALL wFrame"
LINE219="STATE000; CALL HDCRR_ReadRow(prv_ERR_DeltaCounter)"
LINE220="STATE000; CALL HDCRR_ReadRow(EnhancedRR_Delta)"
LINE221="STATE000; CALL INC_ERR_DeltaCounter(EnhancedRR_Delta)"
LINE222="STATE000; CALL DEC_ERR_DeltaCounter(H2RG_rows)"
LINE223="STATE000; RETURN EnhancedRR_GrabFrame"
LINE224=HDCRR_ReadRow:
LINE225="STATE000; CALL wLine"
LINE226="STATE000; CALL PulseVCLK"
LINE227="STATE000; CALL wbVReadEdge"
LINE228="STATE000; CALL LSyncBPulse"
LINE229="STATE000; CALL wReadEN"
LINE230="STATE000; CALL ResetPulse"
LINE231="STATE000; CALL ReadPixel_Blank(2)"
LINE232="STATE000; CALL ReadPixel(H2RG_columns)"
LINE233="STATE000; CALL wVReadEdge"
LINE234="STATE000; CALL LSyncBPulse"
LINE235="STATE000; CALL ReadPixel_Blank(2)"
LINE236="STATE000; CALL ReadPixel(H2RG_columns)"
LINE237="STATE000; CALL wbReadEN"
LINE238="STATE000; RETURN HDCRR_ReadRow"
LINE239=HDCRR_ReadRow_Blank:
LINE240="STATE000; CALL PulseVCLK"
LINE241="STATE000; CALL wbVReadEdge"
LINE242="STATE000; CALL LSyncBPulse"
LINE243="STATE000; CALL wReadEN"
LINE244="STATE000; CALL ResetPulse"
LINE245="STATE000; CALL ReadPixel_Blank(2)"
LINE246="STATE000; CALL ReadPixel_Blank(H2RG_columns)"
LINE247="STATE000; CALL wVReadEdge"
LINE248="STATE000; CALL LSyncBPulse"
LINE249="STATE000; CALL ReadPixel_Blank(2)"
LINE250="STATE000; CALL ReadPixel_Blank(H2RG_columns)"
LINE251="STATE000; CALL wbReadEN"
LINE252="STATE000; RETURN HDCRR_ReadRow_Blank"
LINE253=Guiding_Sequence:
LINE254="STATE000; if Expose CALL GrabWindow"
LINE255="STATE000; if Abort CALL AbortSeq"
LINE256="STATE000; GOTO Guiding_Sequence"
LINE257=GrabWindow:
LINE258="STATE000; Expose--"
LINE259="STATE000; CALL wFrame"
LINE260="STATE000; CALL StartFrame"
LINE261="STATE000; CALL WinRX_ReadRow(H2RG_win_rows)"
LINE262="STATE000; CALL PulseVCLK"
LINE263="STATE000; CALL ExposureTimer"
LINE264="STATE000; RETURN GrabWindow"
LINE265=WinRX_ReadRow:
LINE266="STATE000; CALL wLine"
LINE267="STATE000; CALL StartRow"
LINE268="STATE000; CALL wReadEN"
LINE269="STATE000; CALL ReadPixel_Blank(2)"
LINE270="STATE000; CALL ReadPixel(H2RG_win_columns)"
LINE271="STATE000; CALL ResetPulse"
LINE272="STATE000; CALL wbHclk"
LINE273="STATE000; CALL wbReadEN"
LINE274="STATE000; RETURN WinRX_ReadRow"
LINE275=ExposureTimer:
LINE276="STATE000; if longexposure CALL Sec(exptime)"
LINE277="STATE000; if !longexposure CALL MilliSec(exptime)"
LINE278="STATE000; if Abort GOTO AbortSeq"
LINE279="STATE000; RETURN ExposureTimer"
LINE280=ExposureTimer_us:
LINE281="STATE000; CALL MicroSec(exptime)"
LINE282="STATE000; if Abort GOTO AbortSeq"
LINE283="STATE000; RETURN ExposureTimer_us"
LINE284=MicroSec:
LINE285="STATE000; CALL wDelay1us"
LINE286="STATE000; RETURN MicroSec"
LINE287=MilliSec:
LINE288="STATE000; CALL wDelay1ms"
LINE289="STATE000; RETURN MilliSec"
LINE290=Sec:
LINE291="STATE000; CALL wDelay1ms(1000)"
LINE292="STATE000; if Abort GOTO AbortSeq"
LINE293="STATE000; RETURN Sec"
LINE294=AbortSeq:
LINE295="STATE000; CALL DecrExposeCpt(1000)"
LINE296="STATE000; CALL InitResetCpt(100)"
LINE297="STATE000; mode_VideoRX--"
LINE298="STATE000; mode_VideoRXR--"
LINE299="STATE000; mode_Guiding--"
LINE300="STATE000; Abort--"
LINE301="STATE000; GOTO WaitForExpose"
LINE302=DecrExposeCpt:
LINE303="STATE000; Expose--"
