LINE148="STATE000; if dsch_ser_direction CALL DumpPixelsFOnly(15)"
LINE149="STATE000; if !dsch_ser_dump_bcs CALL TDCser_ReadoutLoop"
LINE150="STATE000; if dsch_ser_dump_bcs CALL TDCser_ReadoutLoopDumpBright"
LINE151="STATE000; if !dsch_ser_direction CALL EvacuateF"
LINE152="STATE000; if dsch_ser_direction CALL EvacuateE"
LINE153="STATE000; CALL serbindecr(ser_bin)"
LINE154="STATE000; CALL serbinincr"
LINE155="STATE000; RETURN LineReadoutTDCser"
LINE156=TDCser_ReadoutLoopDumpBright:
LINE157="STATE000; if !dsch_ser_direction CALL ReadPixelsEOnly(50)"
LINE158="STATE000; if dsch_ser_direction CALL ReadPixelsFOnly(50)"
LINE159="STATE000; CALL TDCser_ReadoutLoopDumpBright_Inner(49)"
LINE160="STATE000; if !dsch_ser_direction CALL ReadPixelsEOnly(15)"
LINE161="STATE000; if dsch_ser_direction CALL ReadPixelsFOnly(15)"
LINE162="STATE000; RETURN TDCser_ReadoutLoopDumpBright"
LINE163=TDCser_ReadoutLoop:
LINE164="STATE000; if !dsch_ser_direction CALL ReadPixelsEOnly(1094)"
LINE165="STATE000; if dsch_ser_direction CALL ReadPixelsFOnly(1094)"
LINE166="STATE000; RETURN TDCser_ReadoutLoop"
LINE167=TDCser_ReadoutLoopDumpBright_Inner:
LINE168="STATE000; CALL trigpix"
LINE169="STATE000; if !dsch_ser_direction CALL DumpPixelsEOnly"
LINE170="STATE000; if dsch_ser_direction CALL DumpPixelsFOnly"
LINE171="STATE000; if !dsch_ser_direction CALL ReadPixelsEOnly(20)"
LINE172="STATE000; if dsch_ser_direction CALL ReadPixelsFOnly(20)"
LINE173="STATE000; RETURN TDCser_ReadoutLoopDumpBright_Inner"
