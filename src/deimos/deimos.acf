LINE106="STATE000; if illum CALL OpenShutter"
LINE107="STATE000; CALL Wait1ms(integrate_illum_ms)"
LINE108="STATE000; CALL Wait1s(integrate_illum_s)"
LINE109="STATE000; if illum CALL CloseShutter"
LINE110="STATE000; CALL Wait1ms(integrate_ms)"
LINE111="STATE000; CALL Wait1s(integrate_s)"
LINE112="STATE000; RETURN Integrate"
LINE113=ReadoutKeep:
