LINE133="STATE000; CALL LineReadoutAOnly(60)"
LINE134="STATE000; CALL ForwardParallelSectionBNoCoincident(llel_bin)"
LINE135="STATE000; CALL linbinincr(1)"
LINE136="STATE000; RETURN FrameReadoutTDCllel_Innerloop"
LINE137=FrameReadoutTDCser:
