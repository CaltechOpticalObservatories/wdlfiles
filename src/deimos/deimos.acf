CONSTANTS=14
LINE0=StartSeqSummitMode:
LINE1="STATE000; CALL InitialSetup"
LINE2="STATE000; CALL InitialSetupFCS"
LINE3="STATE000; CALL SummitModeLoop"
LINE4="STATE000; RETURN StartSeqSummitMode"
LINE5=SummitModeLoop:
LINE6="STATE000; if engmode CALL StartSeqEngMode"
LINE7="STATE000; if engmode_fcs CALL StartSeqEngModeFCS"
LINE8="STATE000; CALL SummitModeFCSLineFlush"
LINE9="STATE000; IF SciStart CALL SummitModeSciIntegrate"
LINE10="STATE000; IF FcsStart CALL SummitModeFCSIntegrate"
LINE11="STATE000; IF SciStop CALL SummitModeSciReadout"
LINE12="STATE000; GOTO SummitModeLoop"
LINE13=SummitModeAllLineFlush:
LINE14="STATE000; CALL ParallelForwardNoCoincident"
LINE15="STATE000; CALL SummitModeFCSLineFlush"
LINE16="STATE000; RETURN SummitModeAllLineFlush"
LINE17=SummitModeFCSLineFlush:
LINE18="STATE000; CALL FCSParallelForward"
LINE19="STATE000; CALL DumpPixelsFCS(1069)"
LINE20="STATE000; RETURN SummitModeFCSLineFlush"
LINE21=SummitModeSciIntegrate:
LINE22="STATE000; SciStart--"
LINE23="STATE000; CALL OpenShutter"
LINE24="STATE000; CALL SummitModeSciDump"
LINE25="STATE000; CALL CloseShutter"
LINE26="STATE000; summit_sci_is_integrating++"
LINE27="STATE000; RETURN SummitModeSciIntegrate"
LINE28=SummitModeFCSIntegrate:
LINE29="STATE000; FcsStart--"
LINE30="STATE000; CALL KeepThisFrame"
LINE31="STATE000; CALL OpenShutter"
LINE32="STATE000; CALL Wait1ms(FcsExpTimeMSec)"
LINE33="STATE000; CALL Wait1s(FcsExpTimeSec)"
LINE34="STATE000; CALL CloseShutter"
LINE35="STATE000; CALL Wait1ms(2)"
LINE36="STATE000; CALL SummitModeFCSReadout"
LINE37="STATE000; RETURN SummitModeFCSIntegrate"
LINE38=EngModeFCSIntegrate:
LINE39="STATE000; CALL KeepThisFrame"
LINE40="STATE000; if illum CALL OpenShutter"
LINE41="STATE000; CALL Wait1ms(integrate_illum_ms)"
LINE42="STATE000; CALL Wait1s(integrate_illum_s)"
LINE43="STATE000; if illum CALL CloseShutter"
LINE44="STATE000; CALL Wait1ms(integrate_ms)"
LINE45="STATE000; CALL Wait1s(integrate_s)"
LINE46="STATE000; CALL Wait1ms(2)"
LINE47="STATE000; CALL SummitModeFCSReadout"
LINE48="STATE000; RETURN EngModeFCSIntegrate"
LINE49=SummitModeSciReadout:
LINE50="STATE000; summit_sci_is_integrating--"
LINE51="STATE000; SciStop--"
LINE52="STATE000; CALL ReadoutBegin"
LINE53="STATE000; CALL Wait1us(50)"
LINE54="STATE000; CALL DumpPixels(1094)"
LINE55="STATE000; if llel_seq CALL LineReadout(4124)"
LINE56="STATE000; if llel_coincident CALL LineReadoutCoincident(4124)"
LINE57="STATE000; CALL ReadoutEnd"
LINE58="STATE000; RETURN SummitModeSciReadout"
LINE59=SummitModeSciDump:
LINE60="STATE000; CALL EvacuateEStart"
LINE61="STATE000; CALL EvacuateFStart"
LINE62="STATE000; CALL ParallelForwardNoCoincident(4124)"
LINE63="STATE000; CALL Wait1us(50)"
LINE64="STATE000; CALL DumpPixels(1094)"
LINE65="STATE000; RETURN SummitModeSciDump"
LINE66=SummitModeFCSReadout:
LINE67="STATE000; CALL FCSLineReadout(4116)"
LINE68="STATE000; RETURN SummitModeFCSReadout"
LINE69=FCSLineReadout:
LINE70="STATE000; CALL FCSParallelForward"
LINE71="STATE000; CALL Wait1us(line_clamp_delay_us)"
LINE72="STATE000; CALL FCSSplitReadout(1069)"
LINE73="STATE000; RETURN FCSLineReadout"
LINE74=StartSeqEngModeFCS:
LINE75="STATE000; if framecount CALL EngModeFCSIntegrate"
LINE76="STATE000; framecount--"
LINE77="STATE000; if !framecount CALL SummitModeFCSLineFlush(4116)"
LINE78="STATE000; if engmode_fcs GOTO StartSeqEngModeFCS"
LINE79="STATE000; GOTO SummitModeLoop"
LINE80=StartSeqEngMode:
LINE81="STATE000; if framecount CALL IntegrateAndReadout"
LINE82="STATE000; if !framecount CALL LineReadoutFast(4124)"
LINE83="STATE000; if rg_mod_test_mode CALL TestBrokenReadout"
LINE84="STATE000; if engmode GOTO StartSeqEngMode"
LINE85="STATE000; GOTO SummitModeLoop"
LINE86=IntegrateAndReadout:
LINE87="STATE000; CALL Integrate"
LINE88="STATE000; CALL ReadoutKeep"
LINE89="STATE000; RETURN IntegrateAndReadout"
LINE90=TestBrokenReadout:
LINE91="STATE000; CALL OutputTestSetup"
LINE92="STATE000; CALL VRDModulate"
LINE93="STATE000; RETURN TestBrokenReadout"
LINE94=EvacuateE:
