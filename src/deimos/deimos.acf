LINE176="STATE000; if dsch_ser_direction CALL DumpPixelsFOnly(21)"
LINE177="STATE000; if !dsch_ser_direction CALL SerialFBackwards(ser_bin)"
LINE178="STATE000; if dsch_ser_direction CALL SerialEBackwards(ser_bin)"
LINE179="STATE000; CALL serbinincr(1)"
LINE180="STATE000; RETURN TDCser_Innerloop"
LINE181=serbinincr:
LINE182="STATE000; ser_bin++"
LINE183="STATE000; RETURN serbinincr"
LINE184=serbindecr:
LINE185="STATE000; ser_bin--"
LINE186="STATE000; RETURN serbindecr"
LINE187=FrameReadout:
