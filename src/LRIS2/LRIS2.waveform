#include "LRIS2.def"


WAVEFORM Wait1ms {
0: SET NOP TO 1;
.+1ms: RETURN;
}

WAVEFORM oshutter {
0: SET BONN_SHUTTER_CTRL to 0;
}

WAVEFORM cshutter {
0: SET BONN_SHUTTER_CTRL to 1;
}

WAVEFORM trig_on {
0: SET TRIG_OUT to 1;
}

WAVEFORM trig_off{
0: SET TRIG_OUT to 0;
}

WAVEFORM FrameStart {
0: SET FRAME TO 1;
}


WAVEFORM LineStart {
0: SET LINE TO 1;
}


WAVEFORM LoopbackIndicateIdle {
0:  SET INTG_LB to 0;
    SET RO_LB TO 0;
    SET IDLE_LB TO 1;
}

WAVEFORM LoopbackIndicateIntg{
0:  SET INTG_LB to 1;
    SET RO_LB TO 0;
    SET IDLE_LB TO 0;
}

WAVEFORM LoopbackIndicateRO{
0:  SET INTG_LB to 0;
    SET RO_LB TO 1;
    SET IDLE_LB TO 0;
}



WAVEFORM dummyPixelReadout {
0: SET PIXEL TO 1;
.+1: SET FRAME TO 0;
    SET LINE TO 0;
    SET PIXEL TO 0;


.+200: SET NOP TO 1;
}
