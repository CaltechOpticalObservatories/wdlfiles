#include "LRIS2.def"


WAVEFORM Wait1ms {
0: SET NOP TO HIGH;
.+1ms: RETURN;
}

WAVEFORM oshutter {
0: SET BONN_SHUTTER_CTRL to 0;
}

WAVEFORM cshutter {
0: SET BONN_SHUTTER_CTRL to 1;
}

WAVEFORM trig_on {
0: SET TRIG_OUT to 1;
}

WAVEFORM trig_off{
0: SET TRIG_OUT to 0;
}

WAVEFORM FrameStart {
0: SET FRAME TO HIGH;
}


WAVEFORM LineStart {
0: SET LINE TO HIGH;
}





WAVEFORM dummyPixelReadout {
0: SET PIXEL TO HIGH;
.+1: SET FRAME TO LOW;
    SET LINE TO LOW;
    SET PIXEL TO LOW;


.+200: SET NOP TO HIGH;
}
