[CONFIG]

PARAMETER0="etime_dark_ms=0"
PARAMETER1="etime_dark_s=0"
PARAMETER2="etime_illum_ms=0"
PARAMETER3="etime_illum_s=0"
PARAMETER4="run_shutter=0"
PARAMETER5="run_illum_trig=0"
PARAMETER6="framecount=0"
PARAMETER7="abort_integration=0"
PARAMETERS=8
LINE0="StartSeq:"
LINE1="STATE000; CALL cshutter"
LINE2="STATE000; CALL trig_off"
LINE3="STATE000; CALL CALL RunSeq"
LINE4="STATE000; RETURN StartSeq"
LINE5="RunSeq:"
LINE6="STATE000; if framecount CALL IntegrateAndReadout"
LINE7="STATE000; GOTO RunSeq"
LINE8="IntegrateAndReadout:"
LINE9="STATE000; CALL CALL Integrate"
LINE10="STATE000; RETURN IntegrateAndReadout"
LINE11="Wait1s:"
LINE12="STATE000; if abort_integration CALL AbortSeq"
LINE13="STATE000; CALL Wait1ms(1000)"
LINE14="STATE000; RETURN Wait1s"
LINE15="AbortSeq:"
LINE16="STATE000; GOTO StartSeq"
LINE17="Integrate:"
LINE18="STATE000; if run_shutter CALL oshutter"
LINE19="STATE000; if run_illum_trig CALL trig_on"
LINE20="STATE000; CALL Wait1s(etime_illum_s)"
LINE21="STATE000; CALL Wait1s(etime_illum_ms)"
LINE22="STATE000; if run_shutter CALL cshutter"
LINE23="STATE000; if run_illum_trig CALL trig_off"
LINE24="STATE000; CALL Wait1s(etime_dark_s)"
LINE25="STATE000; CALL Wait1ms(etime_dark_ms)"
LINE26="STATE000; RETURN Integrate"
LINE27="Wait1ms:"
LINE28="STATE000; STATE000(999998)"
LINE29="STATE000; RETURN Wait1ms"
LINE30="oshutter:"
LINE31="STATE001; RETURN oshutter"
LINE32="cshutter:"
LINE33="STATE002; RETURN cshutter"
LINE34="trig_on:"
LINE35="STATE003; RETURN trig_on"
LINE36="trig_off:"
LINE37="STATE004; RETURN trig_off"
