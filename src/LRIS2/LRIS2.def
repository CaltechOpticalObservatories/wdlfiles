
//control signals
#define BONN_SHUTTER_CTRL 11:5
#define TRIG_OUT 0:1
#define FRAME 0:2
#define LINE 0:3
#define PIXEL 0:4

//GPIO
#define NOP 12:1 //unused GPIO on heaterx


//NOTE need empty line following line trailing comment in WDL1 because oF COURSE YOU DO!

#define CLAMP_OUT 12:4 //CLAMP_OUT_GPIO signal

#define INTG_LB 12:3 //indication that we're integrating

#define RO_LB 12:5 //indication that we're reading out

#define IDLE_LB 12:6 //indication that we're looping waiting on commands



//parallel clocks
#define A1 [A1x, A1y]
#define A2 [A2x, A2y]
#define A3 [A3x, A3y]

#define T1 [T1x, T1y]
#define T2 [T2x, T2y]

#define DG [DGx, DGy]


//serial clocks
#define S1 [S1a, S1b, S1c, S1d]
#define S2 [S2a, S2b, S2c, S2d]
#define S3 [S3a, S3b, S3c, S3d]



//timing things
#define clockfreq  100000000                      /* 100 MHz master clock frequency in Hz */
#define 1ms 1000000 

